# App URL used in verification links
NEXT_PUBLIC_APP_URL=https://pms4u-socialmedia-app.vercel.app

# SMTP configuration (required for real email delivery)
SMTP_HOST=smtp.yourprovider.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM="PulseNet <no-reply@yourdomain.com>"
SMTP_SECURE=false
