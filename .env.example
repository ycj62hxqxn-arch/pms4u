APP_NAME=pms4u
APP_ENV=development
APP_PORT=3000

# Default YAI UI calls the integrated Next route: /api/yai.
# Set NEXT_PUBLIC_YAI_API_BASE only when running the standalone server.
# Set NEXT_OUTPUT=export only for static exports; static exports cannot serve /api/yai.
YAI_HOST=127.0.0.1
YAI_PORT=3001
YAI_ALLOWED_ORIGIN=http://127.0.0.1:3000
# NEXT_PUBLIC_YAI_API_BASE=http://127.0.0.1:3001
# NEXT_OUTPUT=export

LOG_LEVEL=info
SERVICE_VERSION=phase-1
AUTH_MODE=disabled
JWT_SECRET=changeme
DATABASE_URL=
REDIS_URL=

# Required for receipt signing/verification in governed inbound routes.
# Must be at least 32 characters; production will fail closed if missing.
PMS_RECEIPT_SIGNING_SECRET=

# Required in production for distributed rate limiting on expensive/public endpoints.
# When missing in production, endpoints fail closed with 503 RATE_LIMIT_UNAVAILABLE.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Leave OPENAI_API_KEY empty to demo the local MCV fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# Phone/WhatsApp webhook secret (optional): set this and your provider should send it
# as header `x-phone-secret` to authenticate inbound webhooks.
PHONE_WEBHOOK_SECRET=

# If your provider is Twilio and you want to verify signatures, set:
# TWILIO_AUTH_TOKEN=

# Public host used by the webhook forwarder. Change to your deployed URL when deploying.
# Example: https://pms4u-xxxx.vercel.app or https://www.gtcs4u.com
NEXT_PUBLIC_SITE_URL=

# Required for authenticating inbound agent execution, verification, and event routes.
# Use a high-entropy secret and never expose it to browser code.
PMS_INBOUND_SHARED_SECRET=
